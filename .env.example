# Copy to .env and fill in. APP_ENV selects which overlay file (.env.local,
# .env.staging, .env.production) is merged on top of this one — see
# app/config/env.php.

APP_ENV=local
APP_NAME=visibility-engine
APP_URL=http://localhost:8080
APP_DEBUG=true

# At-rest encryption key for sensitive columns (sites.wp_app_password,
# sites.gsc_refresh_token). Generate with:
# php -r "echo base64_encode(sodium_crypto_secretbox_keygen());"
APP_KEY=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=visibility_engine
DB_USERNAME=root
DB_PASSWORD=

# JWT
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Stripe (test mode keys while building — see https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create the Products/Prices in test mode first, then
# paste their price IDs here — used by migrations/seeds/seed_plans.php)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# Worker (cron-invoked batch run — see workers/worker.php)
WORKER_BATCH_SIZE=20

# Google OAuth (Search Console API) — create an OAuth 2.0 Client ID in
# Google Cloud Console, enable the Search Console API, add
# {APP_URL}/api/v1/gsc/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/gsc/callback

# Claude API (content drafting) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# SMTP (ready_for_review / published notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@example.com
SMTP_FROM_NAME=visibility-engine
NOTIFICATION_EMAIL_TO=
