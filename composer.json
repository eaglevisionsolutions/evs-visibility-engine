{
    "name": "eaglevisionsolutions/visibility-engine",
    "description": "Multi-tenant SEO + AEO visibility platform (internal codename: visibility-engine)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-sodium": "*",
        "stripe/stripe-php": "^16.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
